# Local development environment variables.
# Copy to .env (gitignored):  cp .env.example .env
#
# internal/config.Load() uses github.com/joho/godotenv; missing .env is OK if vars are exported in the shell.

# HTTP port (listen address is ":" + PORT). Optional — defaults to 8080 when unset or blank.
PORT=8080

# Stripe webhook signing secret (Dashboard webhook endpoint, or Stripe CLI for local testing).
# Required: app exits at startup if missing or whitespace-only.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Postgres DSN for idempotency ledger (Milestone 8). Required: app exits at startup if missing.
# After `make db-up`, use the dev URL (see DATABASE_URL_DEV in Makefile).
DATABASE_URL=postgres://webhook:webhook@localhost:5433/stripe_webhook_dev?sslmode=disable
