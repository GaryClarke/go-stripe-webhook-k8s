# Local development environment variables.
# Copy to .env (gitignored) and edit:  cp .env.example .env
#
# internal/config.Load() uses github.com/joho/godotenv; missing .env is OK if vars are exported in the shell.

# HTTP port (listen address is ":" + PORT). Optional - defaults to 8080 when unset or blank.
PORT=8080

# Stripe webhook signing secret (Dashboard - webhook endpoint, or Stripe CLI for local testing).
# Required for cmd/api: app exits at startup if missing or whitespace-only.
# Never commit a real secret; use .env locally and OpenShift/Kubernetes Secrets in prod.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
